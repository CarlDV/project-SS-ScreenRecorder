<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DeviceDefault on a Samsung device *is* One UI: system font, ripple, radio styling.
         There is no Theme.DeviceDefault.DayNight.NoActionBar in the platform, so the action
         bar is turned off here instead - day/night following the system matters more. -->
    <style name="Theme.Sheet" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <!-- A bottom sheet dismisses by tapping the dim, the way every One UI sheet does. -->
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>

    <!-- StartActivity has no content: it exists to run the permission gates and the consent
         dialog. Everything here is about making sure the user never sees a window for it:
         no background, no dim, no enter animation, and no starting-window preview flash. -->
    <style name="Theme.Invisible" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
